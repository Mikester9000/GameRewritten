{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug x64 (MSBuild)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}\\GameRewritten.vcxproj",
        "/t:Build",
        "/p:Configuration=Debug;Platform=x64",
        "/m",
        "/nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Release x64 (MSBuild)",
      "type": "shell",
      "command": "msbuild",
      "args": [
        "${workspaceFolder}\\GameRewritten.vcxproj",
        "/t:Build",
        "/p:Configuration=Release;Platform=x64",
        "/m",
        "/nologo"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "build"
    }
  ]
}
